/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'

/index.html
  Cache-Control: no-cache

/app.js
  Cache-Control: public, max-age=300, must-revalidate
/api.js
  Cache-Control: public, max-age=300, must-revalidate
/auth.js
  Cache-Control: public, max-age=300, must-revalidate
/admin.js
  Cache-Control: public, max-age=300, must-revalidate
/style.css
  Cache-Control: public, max-age=300, must-revalidate
/Sortable.min.js
  Cache-Control: public, max-age=86400, immutable

/icons/*
  Cache-Control: public, max-age=2592000, immutable
/favicon.svg
  Cache-Control: public, max-age=864000
