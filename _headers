/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'

/index.html
  Cache-Control: no-cache

# 应用代码之间互相依赖，缓存过期时间不一致会导致新旧脚本混用；统一改为每次都回源校验
/app.js
  Cache-Control: no-cache
/boot.js
  Cache-Control: no-cache
/api.js
  Cache-Control: no-cache
/auth.js
  Cache-Control: no-cache
/admin.js
  Cache-Control: no-cache
/style.css
  Cache-Control: no-cache
/Sortable.min.js
  Cache-Control: public, max-age=86400, immutable

/icons/*
  Cache-Control: public, max-age=2592000, immutable
/favicon.svg
  Cache-Control: public, max-age=864000
